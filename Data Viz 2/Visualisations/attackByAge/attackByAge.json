{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "title": "Shark Attacks by Age of Victim",
    "data": {
        "url": "Data Viz 2\\Visualisations\\attackByAge\\attackbyAge.csv",
        "format": {"type": "csv"}
    },
    "width": 400,
    "height": 300,
    "mark": {
        "type": "bar",
        "tooltip": true
    },
    "encoding": {
        "x": {"field": "Victim\\.age", "type": "quantitative", "title": "Age", "scale": {"domain": [0, 90]}, "bin": {"maxbins": 20}},
        "y": {"aggregate": "count", "title": "Total Attacks"},
        "color": {
            "value": "lightblue"
        }
    },
    "config": {
        "axis": {
          "labelFont": "Arial", 
          "labelFontSize": 12,  
          "titleFont": "Arial",  
          "titleFontSize": 14     
        },
        "legend": {
          "labelFont": "Arial",     
          "labelFontSize": 12,       
          "titleFont": "Arial",     
          "titleFontSize": 14,
          "symbolSize": 200
        },
        "title": {
          "font": "Arial",         
          "fontSize": 16     
        }
      }
}