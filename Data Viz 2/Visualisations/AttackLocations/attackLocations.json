{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "width": 300,
    "height": 300,
    "projection": {
      "type": "mercator",
      "scale": 350,
      "center": [130, -25],
      "translate": [150, 150]
    },
    "layer": [
      {
        "data": {
          "url": "https://raw.githubusercontent.com/dnguyen220022/FIT3179/refs/heads/main/Data%20Viz%202/data/ausMap.json",
          "format": { "type": "topojson", "feature": "ne_110m_graticules_30" }
        },
        "mark": { "type": "geoshape", "fill": "null", "stroke": null }
      },
      {
        "data": {
          "url": "https://raw.githubusercontent.com/dnguyen220022/FIT3179/refs/heads/main/Data%20Viz%202/data/ausMap.json",
          "format": { "type": "topojson", "feature": "ne_110m_admin_0_countries" }
        },
        "mark": { "type": "geoshape", "fill": "lightgray", "stroke": "white" }
      },
      {
        "data": {
          "url": "https://raw.githubusercontent.com/dnguyen220022/FIT3179/refs/heads/main/Data%20Viz%202/data/locdat2.csv",
          "format": { "type": "csv" }
        },
        "mark": { "type": "circle", "tooltip": { "content": "data" } },
        "encoding": {
          "longitude": { "field": "Longitude", "type": "quantitative" },
          "latitude": { "field": "Latitude", "type": "quantitative" },
          "size": { "value": 30 },
          "color": {
            "field": "Victim\\.injury",
            "type": "nominal",
            "title": "Injury Status",
            "scale": { 
                "domain": ["fatal", "injured", "uninjured"],
                "range": ["red", "yellow", "darkgreen"] 
            },
            "legend": { 
                "title": "Injury Status",
                "labelExpr": "datum.label == 'fatal' ? 'Fatal' : datum.label == 'injured' ? 'Injured' : 'Uninjured'"
                
            }
          }
        },
        "transform": [
          {
            "filter": "SharkType == 'All' || datum['Shark\\.common\\.name'] == SharkType"
          }
        ]
      }
    ],
    "params": [
      {
        "name": "SharkType",
        "value": "All",
        "bind": {
          "input": "select",
          "options": ["All", "white shark", "tiger shark", "wobbegong", "bull shark", "whaler shark"],
          "labels": ["All", "Great White", "Tiger Shark", "Wobbegong", "Bull Shark", "Whaler Shark"],
          "name": "Shark Type "
        }
      }
    ],
    "config": {
      "axis": {
        "labelFont": "Arial",
        "labelFontSize": 12,
        "titleFont": "Arial",
        "titleFontSize": 14
      },
      "legend": {
        "labelFont": "Arial",
        "labelFontSize": 12,
        "titleFont": "Arial",
        "titleFontSize": 14,
        "symbolSize": 200
      },
      "title": {
        "font": "Arial",
        "fontSize": 16
      }
    }
  }